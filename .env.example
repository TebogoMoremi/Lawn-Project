# Public business contact number: international digits only, without + or spaces.
# Leave empty until a real business number is supplied. Never put credentials here.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Server-only PostgreSQL URL. Replace placeholders for your own development DB.
# Never use a production database for development, seeding, resetting or tests.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lawnflow?schema=public"
# Explicit opt-in for the reference-data development seed (not production).
ALLOW_DEVELOPMENT_SEED=false
